{
  "name": "fixy-agent",
  "version": "0.1.0",
  "description": "Local Ollama-powered CLI coding agent — reads errors, edits files, runs commands, and iterates until the bug is fixed.",
  "type": "module",
  "bin": {
    "fixy": "./bin/fixy.js"
  },
  "main": "./bin/fixy.js",
  "scripts": {
    "start": "node ./bin/fixy.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
